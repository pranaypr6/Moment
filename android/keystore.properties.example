# Copy this file to keystore.properties (same folder) and fill in real values.
# keystore.properties is gitignored and must NEVER be committed.
#
# storeFile is relative to the android/ project root, e.g. keystore/moment-release.jks
storeFile=keystore/moment-release.jks
storePassword=CHANGE_ME
keyAlias=moment-release
keyPassword=CHANGE_ME
